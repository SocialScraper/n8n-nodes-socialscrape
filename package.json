{
  "name": "n8n-nodes-socialscrape",
  "version": "0.1.0",
  "description": "n8n community node for SocialScrape: social media data (profiles, posts, comments, search, ads, transcripts) from TikTok, Instagram, YouTube, X, LinkedIn, Reddit and more in one response shape, plus a trigger that starts a workflow on new posts.",
  "keywords": [
    "n8n-community-node-package",
    "socialscrape",
    "social-media",
    "social-media-api",
    "tiktok",
    "instagram",
    "youtube",
    "twitter",
    "linkedin",
    "reddit",
    "transcript"
  ],
  "license": "MIT",
  "homepage": "https://socialscrape.dev",
  "author": {
    "name": "SocialScrape",
    "email": "hello@socialscrape.dev",
    "url": "https://socialscrape.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SocialScraper/n8n-nodes-socialscrape.git"
  },
  "bugs": {
    "url": "https://github.com/SocialScraper/n8n-nodes-socialscrape/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SocialScrapeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SocialScrape/SocialScrape.node.js",
      "dist/nodes/SocialScrape/SocialScrapeTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.2",
    "@types/node": "^22.0.0",
    "eslint": "9.29.0",
    "n8n-workflow": "*",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
